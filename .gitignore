# Compiled binary outputs + temp test files from cpp/gen/
# Tracked sources live under cpp/gen/legacy/ and (eventually) cpp/gen/box/.
# Everything else under those subdirs (binaries, tempfile generations) is ignored.
cpp/gen/legacy/*
!cpp/gen/legacy/*.cpp
cpp/gen/legacy/cpp_test*.cpp
cpp/gen/legacy/test_*.cpp
cpp/gen/box/*
!cpp/gen/box/.gitkeep
!cpp/gen/box/Makefile

# Onigmo build outputs (vendored via git submodule; built locally on demand)
vendor/Onigmo/_install/
bench/stubs/_unified.rb

# Built frozone-cpp binary (rake frozone:build) — ignore the dir wholesale,
# then un-ignore checked-in shim scripts (bin/frozone-rb).
/bin/
!/bin/frozone-rb
